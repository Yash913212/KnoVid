# KnoVid backend — environment variables
# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the API server
PORT=3001

# Supabase project URL and public key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Server-only key for backend database/worker writes.
# New Supabase projects use sb_secret_...; the older service-role alias also works.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Redis connection string (local or Upstash free tier)
REDIS_URL=redis://localhost:6379

# Directory where uploaded videos are stored
UPLOAD_DIR=./uploads

# Base URL of the Python processing service (FastAPI)
PROCESSING_SERVICE_URL=http://localhost:8000

# Shared secret sent to the processing service as X-Processing-Auth.
# Must match PROCESSING_AUTH_TOKEN there. Leave empty to skip auth (local dev).
PROCESSING_AUTH_TOKEN=

# Timeout in ms for the /process (transcription) pipeline call.
# Long videos transcribe slowly; raise this if videos fail with timeouts.
PROCESSING_TIMEOUT_MS=600000
