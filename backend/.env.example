# KnoVid backend — environment variables
# Copy to .env and fill in real values. Never commit .env.

# HTTP port for the API server
PORT=3001

# MongoDB connection string (local or MongoDB Atlas free tier)
MONGODB_URI=mongodb://localhost:27017/knovid

# Redis connection string (local or Upstash free tier)
REDIS_URL=redis://localhost:6379

# Secret used to sign JWTs — use a long random string in any non-local env
JWT_SECRET=change-me-to-a-long-random-string

# Directory where uploaded videos are stored
UPLOAD_DIR=./uploads

# Base URL of the Python processing service (FastAPI)
PROCESSING_SERVICE_URL=http://localhost:8000
