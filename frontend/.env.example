# KnoVid frontend — environment variables
# Copy to .env and fill in real values. Never commit .env.
# All vars are optional in local dev: Vite proxies /api -> http://localhost:3001
# (see vite.config.ts). Set VITE_API_URL to talk to a non-local backend.

# Base URL of the backend API (optional; default: /api via Vite dev proxy)
VITE_API_URL=

# Supabase public browser configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
