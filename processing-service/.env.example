# KnoVid processing service — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Optional Hugging Face token for pyannote speaker diarization.
# Required only if you want speaker labels.
HF_TOKEN=

# Optional shared secret for protecting these endpoints. When set, the
# backend must send the same value as the X-Processing-Auth header.
PROCESSING_AUTH_TOKEN=

# OpenAI-compatible LLM endpoint (optional; falls back to templates without it)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Ollama fallback (OpenAI-compatible endpoint, usually http://localhost:11434/v1)
OLLAMA_ENABLED=true
OLLAMA_API_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b

# CORS origins for browser access (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Directory where downloads and extracted audio are stored.
# Defaults to <repo>/backend/uploads when unset.
# UPLOAD_DIR=./uploads