# KnoVid processing service — environment variables
# Copy to .env and fill in real values. Never commit .env.

# Directory where downloaded videos / extracted audio are stored.
# Must point at the same UPLOAD_DIR the backend uses.
UPLOAD_DIR=../backend/uploads

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL=base

# Hugging Face token for pyannote speaker diarization.
# Optional — leave empty to skip speaker labels (transcription still works).
# Requires accepting the pyannote model licenses on huggingface.co.
HF_TOKEN=

# OpenAI-compatible LLM API (OpenAI, OpenRouter, local Ollama, etc.)
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local Ollama fallback. Install Ollama and pull qwen3:8b.
OLLAMA_ENABLED=true
OLLAMA_API_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b

# CORS origins allowed to call this service directly (comma-separated)
CORS_ORIGINS=http://localhost:5173
